COMPOSE_PROJECT_NAME=paperless

# eg hetzner storage box (used by the backup sidecar as BORG_REPO)
BORG_REPO=ssh://<STORAGEBOX_USER>@<STORAGEBOX_USER>.your-storagebox.de:23/./paperless

BORG_PASSPHRASE=password

PAPERLESS_DBUSER=dbuser
PAPERLESS_DBPASS=dbpassword


###############################################################################
# Doxie scanner client (see docker-compose.yml `doxie` service)
###############################################################################

# Scanner IP. 10.10.100.1 is the default when the Doxie creates its own
# Wi-Fi network (AP mode). In client mode use the scanner's DHCP/static IP.
DOXIE_IP=10.10.100.1

# How often (seconds) to poll the scanner for new scans.
DOXIE_POLL_INTERVAL=300

# Optional scanner password. Only needed if you enabled authentication in the
# Doxie app; leave commented out otherwise.
#DOXIE_PASSWORD=your-doxie-password

# Optional: probe/download timeouts in seconds.
#DOXIE_TIMEOUT=3
#DOXIE_DOWNLOAD_TIMEOUT=120

# Optional: uid:gid given to files dropped into the consume dir (matches
# paperless' USERMAP_UID / USERMAP_GID).
#CONSUME_OWNER=999:995

# Optional: dpi above which a JPG scan is downscaled to 300 dpi.
# 300 dpi scans are kept as-is; 600 dpi scans are resized 50%.
#DPI_THRESHOLD=300


###############################################################################
# Paperless-ngx settings, add environment directive in docker-compose
###############################################################################

# See http://docs.paperless-ngx.com/configuration/ for all available options.

# The UID/GID used to run paperless in the container. The doxie sidecar chowns
# the files it drops into the consume dir to this same uid/gid (CONSUME_OWNER
# defaults to 999:995 - keep them in sync if you change these).
#USERMAP_UID=1000
#USERMAP_GID=1000

# See the documentation linked above for all options. A few commonly adjusted settings
# are provided below.

# This is required if you will be exposing Paperless-ngx on a public domain
# (if doing so please consider security measures such as reverse proxy)
#PAPERLESS_URL=https://paperless.example.com

# Required. A unique secret key for session tokens and signing.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=change-me

# Use this variable to set a timezone for the Paperless Docker containers. Defaults to UTC.
#PAPERLESS_TIME_ZONE=Europe/Berlin

# The default language to use for OCR. Set this to the language most of your
# documents are written in.
#PAPERLESS_OCR_LANGUAGE=deu

# Additional languages to install for text recognition, separated by a whitespace.
# Note that this is different from PAPERLESS_OCR_LANGUAGE (default=eng), which defines
# the language used for OCR.
# The container installs English, German, Italian, Spanish and French by default.
# See https://packages.debian.org/search?keywords=tesseract-ocr-&searchon=names
# for available languages.
#PAPERLESS_OCR_LANGUAGES=tur ces
